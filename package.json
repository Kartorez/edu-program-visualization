{
  "name": "edu-program-visualization",
  "version": "1.0.0",
  "description": "Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.80.0",
    "@payloadcms/next": "3.80.0",
    "@payloadcms/richtext-lexical": "3.80.0",
    "@payloadcms/ui": "3.80.0",
    "@sparticuz/chromium": "^133.0.0",
    "@xyflow/react": "^12.10.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "fuse.js": "^7.3.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nextjs-toploader": "^3.9.17",
    "payload": "3.80.0",
    "puppeteer-core": "^25.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.99.0",
    "sharp": "0.34.2",
    "slugify": "^1.6.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
