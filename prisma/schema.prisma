generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// Відповідають значенням Payload select-полів
// ─────────────────────────────────────────────

// disciplines.type: 'required' | 'elective'
enum DisciplineType {
  REQUIRED
  ELECTIVE
}

// disciplines.category: 'standard' | 'practice' | 'thesis'
enum DisciplineCategory {
  STANDARD
  PRACTICE
  THESIS
}

// disciplines.assessment: 'exam' | 'credit' | 'exam_credit'
enum AssessmentType {
  EXAM
  CREDIT
  EXAM_CREDIT
}

// competencies.type: 'zk' | 'sk'
enum CompetencyType {
  ZK
  SK
}

// ─────────────────────────────────────────────
// disciplines (Payload slug: 'disciplines')
// ─────────────────────────────────────────────

model Discipline {
  id          String @id @default(cuid())

  // Основне
  code        String  @unique               // required: true
  year        Int                           // required: true, defaultValue: new Date().getFullYear()
  name        String                        // required: true
  shortName   String?

  displayName String?                       // hidden, computed: "[code] name (year)"

  description String?

  // Тип і категорія
  type        DisciplineType                // required: true
  category    DisciplineCategory @default(STANDARD)

  // Група вибіркових — relationship to 'elective-groups'
  electiveGroupId String?
  electiveGroup   ElectiveGroup? @relation(fields: [electiveGroupId], references: [id])

  // Навантаження
  credits     Int?
  hours       Int?

  // Форма контролю — не required
  assessment  AssessmentType?

  // semesters: select hasMany, значення "1".."12"
  // Зберігається як окрема таблиця (Payload: disciplines_rels або окрема pivot)
  semesters   DisciplineSemester[]

  // topics: array { semester: number, title: string }
  topics      CourseTopic[]

  // prerequisites / postrequisites — обчислюються через DisciplineRelation
  asSubject    DisciplineRelation[] @relation("RelationSubject")   // ця дисципліна залежить від dependsOn
  asDependency DisciplineRelation[] @relation("RelationDependsOn") // інші дисципліни залежать від цієї

  // Матриці
  // competencies: relationship to 'competencies', hasMany
  competencies DisciplineCompetency[]
  // learningOutcomes: relationship to 'learning-outcomes', hasMany
  outcomes     DisciplineOutcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// semesters (поле disciplines.semesters)
// Payload: select hasMany, options: "1".."12"
// Pivot-таблиця: disciplineId + semester (Int 1-12)
// ─────────────────────────────────────────────

model DisciplineSemester {
  id           String     @id @default(cuid())

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  semester     Int        // 1–12, відповідає значенням Payload select

  @@unique([disciplineId, semester])
}

// ─────────────────────────────────────────────
// topics (поле disciplines.topics)
// Payload: array, fields: { semester: number, title: string }
// order зберігає порядок елементів масиву Payload
// ─────────────────────────────────────────────

model CourseTopic {
  id           String     @id @default(cuid())

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  semester     Int        // Сем. (required: true)
  title        String     // Тема (required: true)
  order        Int        // порядок елементу в масиві
}

// ─────────────────────────────────────────────
// discipline-relations (Payload slug: 'discipline-relations')
// subject залежить від dependsOn
// (dependsOn є пререквізитом для subject)
// ─────────────────────────────────────────────

model DisciplineRelation {
  subjectId   String
  dependsOnId String

  subject    Discipline @relation("RelationSubject",   fields: [subjectId],   references: [id], onDelete: Cascade)
  dependsOn  Discipline @relation("RelationDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([subjectId, dependsOnId])
}

// ─────────────────────────────────────────────
// elective-groups (Payload slug: 'elective-groups')
// ─────────────────────────────────────────────

model ElectiveGroup {
  id   String  @id @default(cuid())

  code String  @unique   // required: true, unique: true
  name String?           // не required

  disciplines Discipline[]
}

// ─────────────────────────────────────────────
// competencies (Payload slug: 'competencies')
// ─────────────────────────────────────────────

model Competency {
  id          String         @id @default(cuid())

  code        String         @unique  // required: true, unique: true
  type        CompetencyType          // required: true
  description String?                 // textarea, не required

  disciplines DisciplineCompetency[]
}

// M:N: disciplines <-> competencies
model DisciplineCompetency {
  disciplineId String
  competencyId String

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([disciplineId, competencyId])
}

// ─────────────────────────────────────────────
// learning-outcomes (Payload slug: 'learning-outcomes')
// ─────────────────────────────────────────────

model LearningOutcome {
  id          String  @id @default(cuid())

  code        String          // required: true (не unique в Payload)
  description String?         // textarea, не required

  disciplines DisciplineOutcome[]
}

// M:N: disciplines <-> learning-outcomes
model DisciplineOutcome {
  disciplineId String
  outcomeId    String

  discipline Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  outcome    LearningOutcome @relation(fields: [outcomeId],    references: [id], onDelete: Cascade)

  @@id([disciplineId, outcomeId])
}